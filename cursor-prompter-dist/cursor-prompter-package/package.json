{
  "name": "cursor-prompter",
  "displayName": "Cursor Prompter",
  "description": "Automatically send timed messages to Cursor AI chat interface to maintain conversations",
  "version": "0.2.0",
  "publisher": "cursortools",
  "author": {
    "name": "Cursor Tools Team"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cursortools/cursor-prompter"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Education"
  ],
  "keywords": [
    "cursor",
    "ai",
    "chat",
    "prompt",
    "automation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-prompter.enable",
        "title": "Enable Cursor Prompter",
        "category": "Cursor Prompter"
      },
      {
        "command": "cursor-prompter.disable",
        "title": "Disable Cursor Prompter",
        "category": "Cursor Prompter"
      },
      {
        "command": "cursor-prompter.toggle",
        "title": "Toggle Cursor Prompter",
        "category": "Cursor Prompter"
      },
      {
        "command": "cursor-prompter.sendNow",
        "title": "Send Message to Cursor Chat Now",
        "category": "Cursor Prompter"
      },
      {
        "command": "cursor-prompter.openSettings",
        "title": "Open Cursor Prompter Settings",
        "category": "Cursor Prompter"
      },
      {
        "command": "cursor-prompter.testFocusCommands",
        "title": "Test Focus Commands for Compatibility",
        "category": "Cursor Prompter"
      }
    ],
    "configuration": {
      "title": "Cursor Prompter",
      "properties": {
        "cursorPrompter.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable automatic message sending to Cursor's chat"
        },
        "cursorPrompter.interval": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "description": "Interval in milliseconds between automated messages (minimum 5000ms recommended)"
        },
        "cursorPrompter.message": {
          "type": "string",
          "default": "Continue with your previous thoughts.",
          "description": "Default message to send (when not using message sequence)"
        },
        "cursorPrompter.useMessageSequence": {
          "type": "boolean",
          "default": true,
          "description": "Use a sequence of messages instead of a single message"
        },
        "cursorPrompter.messageSequence": {
          "type": "array",
          "default": [
            "Continue with your previous thoughts.",
            "What else would you suggest?",
            "Please elaborate more on this topic.",
            "Can you provide more specific details?",
            "Are there any potential issues with this approach?",
            "Could you expand on the advantages of this solution?"
          ],
          "description": "Sequence of messages to cycle through when useMessageSequence is enabled"
        },
        "cursorPrompter.focusCommand": {
          "type": "string",
          "default": "cursor.chatPanel.focus",
          "description": "Command to focus the Cursor chat panel (use 'Test Focus Commands' to find compatible commands)"
        },
        "cursorPrompter.autoSend": {
          "type": "boolean",
          "default": true,
          "description": "Automatically press Enter to send the message after inserting it"
        },
        "cursorPrompter.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notification popups when messages are sent"
        },
        "cursorPrompter.retryAttempts": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 5,
          "description": "Number of retry attempts for clipboard operations"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "cursor-prompter.sendNow",
          "group": "cursorPrompter",
          "when": "editorFocus"
        }
      ],
      "editor/title": [
        {
          "command": "cursor-prompter.toggle",
          "group": "navigation",
          "when": "resourceScheme == untitled"
        }
      ],
      "commandPalette": [
        {
          "command": "cursor-prompter.enable",
          "when": "!config.cursorPrompter.enabled"
        },
        {
          "command": "cursor-prompter.disable",
          "when": "config.cursorPrompter.enabled"
        },
        {
          "command": "cursor-prompter.toggle"
        },
        {
          "command": "cursor-prompter.sendNow"
        },
        {
          "command": "cursor-prompter.openSettings"
        },
        {
          "command": "cursor-prompter.testFocusCommands"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cursor-prompter.toggle",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus"
      },
      {
        "command": "cursor-prompter.sendNow",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.99.1",
    "@vscode/test-electron": "^2.1.5",
    "typescript": "^4.9.5"
  },
  "license": "MIT"
}
