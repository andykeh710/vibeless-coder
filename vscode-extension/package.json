{
  "name": "cursor-chat-automation",
  "displayName": "Cursor Chat Automation",
  "description": "Automatically sends messages to Cursor AI chat interface at configurable intervals",
  "version": "0.1.0",
  "publisher": "MR.Janders",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-automation.enable",
        "title": "Enable Cursor Chat Automation"
      },
      {
        "command": "cursor-automation.disable",
        "title": "Disable Cursor Chat Automation"
      },
      {
        "command": "cursor-automation.sendNow",
        "title": "Send Message to Cursor Chat Now"
      },
      {
        "command": "cursor-automation.openSettings",
        "title": "Open Cursor Chat Automation Settings"
      }
    ],
    "configuration": {
      "title": "Cursor Chat Automation",
      "properties": {
        "cursorAutomation.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable or disable automatic message sending to Cursor's chat"
        },
        "cursorAutomation.interval": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "description": "Interval in milliseconds between automated messages (minimum 5000ms recommended)"
        },
        "cursorAutomation.message": {
          "type": "string",
          "default": "Continue with your previous thoughts. What else would you suggest?",
          "description": "Message to send to Cursor AI chat"
        },
        "cursorAutomation.autoSend": {
          "type": "boolean",
          "default": true,
          "description": "Automatically press Enter to send the message after inserting it"
        },
        "cursorAutomation.showNotifications": {
          "type": "boolean",
          "default": true,
          "description": "Show notifications when messages are sent"
        },
        "cursorAutomation.playSound": {
          "type": "boolean",
          "default": false,
          "description": "Play a sound when messages are sent"
        },
        "cursorAutomation.messageTemplates": {
          "type": "array",
          "default": [
            "Continue with your previous thoughts. What else would you suggest?",
            "Please elaborate more on this topic.",
            "That's interesting. Tell me more about that approach.",
            "What alternatives should I consider?",
            "Can you provide examples of how this would work?"
          ],
          "description": "List of message templates that can be used (future feature)"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "cursor-automation.sendNow",
          "group": "cursorAutomation"
        }
      ],
      "view/title": [
        {
          "command": "cursor-automation.openSettings",
          "when": "view == cursorAutomationView"
        }
      ],
      "commandPalette": [
        {
          "command": "cursor-automation.enable",
          "when": "!config.cursorAutomation.enabled"
        },
        {
          "command": "cursor-automation.disable",
          "when": "config.cursorAutomation.enabled"
        },
        {
          "command": "cursor-automation.sendNow"
        },
        {
          "command": "cursor-automation.openSettings"
        }
      ]
    },
    "statusBar": {
      "text": "Cursor Chat Auto",
      "command": "cursor-automation.toggle",
      "tooltip": "Toggle Cursor Chat Automation"
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^7.2.0",
    "@types/mocha": "^9.1.1",
    "@types/node": "16.x",
    "glob": "^8.0.3",
    "mocha": "^10.0.0",
    "typescript": "^4.7.4",
    "ts-loader": "^9.3.1",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "@vscode/test-electron": "^2.1.5"
  }
}